box "front_left" pos(-3.0,1.4,-9.0) size(2.4,2.8,0.2) gray(0.35)
box "front_right" pos(2.8,1.4,-9.0) size(2.8,2.8,0.2) gray(0.36)
box "front_header" pos(0.1,2.45,-9.0) size(1.8,0.7,0.2) gray(0.39)

box "side_recess_mask" pos(-2.9,1.4,4.2) size(1.4,2.8,2.6) gray(0.28)
box "pillar" pos(2.6,1.4,2.2) size(0.55,2.8,0.55) gray(0.43)
box "bench" pos(-1.6,0.45,1.8) size(1.8,0.9,0.65) gray(0.24)
box "tilted_panel" pos(1.45,1.35,-1.9) size(0.12,2.2,1.1) rot(0.0,18.0,0.0) gray(0.46)
box "far_block" pos(1.6,0.55,6.2) size(1.5,1.1,1.6) gray(0.29)
