#version 450
// Per-head RMS norm (weighted for Q/K, plain for V) then NEOX RoPE, one
// workgroup per (head slot, token). Q goes to q_out [8][n][hd] f32; K/V are
// written in place into the f16 caches [2][cap][hd] at position p0 + token.
// Slots: 0-7 Q, 8-9 K, 10-11 V (HAS_KV) or 0-7 Q only.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint HD = 256;
layout(std430, binding = 0) readonly buffer Q { float q[]; };
layout(std430, binding = 1) readonly buffer K { float k[]; };
layout(std430, binding = 2) readonly buffer V { float v[]; };
layout(std430, binding = 3) readonly buffer QW { float qw[]; };
layout(std430, binding = 4) readonly buffer KW { float kw[]; };
layout(std430, binding = 5) readonly buffer F { float inv_freq[]; };
layout(std430, binding = 6) writeonly buffer QO { float qo[]; };
layout(std430, binding = 7) writeonly buffer KC { float16_t kc[]; };
layout(std430, binding = 8) writeonly buffer VC { float16_t vc[]; };
layout(push_constant) uniform P { uint n; uint p0; uint cap; } p;
shared float scratch[256];
#include "reduce.glsl"

const uint PAIRS = HD / 2;

void main()
{
    const uint slot = gl_WorkGroupID.x;
    const uint t = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationID.x;
    const uint kind = slot < 8 ? 0 : slot < 10 ? 1 : 2;
    const uint h = kind == 0 ? slot : kind == 1 ? slot - 8 : slot - 10;
    const uint src = kind == 0 ? (t * 8 + h) * HD : (t * 2 + h) * HD;
    float a[2];
    float b[2];
    float ss = 0.0;
    [[unroll]] for (uint j = 0; j < 2; ++j) {
        const uint i = tid + j * 256;
        a[j] = 0.0;
        b[j] = 0.0;
        if (i < PAIRS) {
            if (kind == 0) { a[j] = q[src + i]; b[j] = q[src + i + PAIRS]; }
            else if (kind == 1) { a[j] = k[src + i]; b[j] = k[src + i + PAIRS]; }
            else { a[j] = v[src + i]; b[j] = v[src + i + PAIRS]; }
        }
        ss += a[j] * a[j] + b[j] * b[j];
    }
    const float inv = inversesqrt(workgroup_sum(ss) / float(HD) + 1e-6);
    const float position = float(p.p0 + t);
    const uint cache = (h * p.cap + p.p0 + t) * HD;
    [[unroll]] for (uint j = 0; j < 2; ++j) {
        const uint i = tid + j * 256;
        if (i >= PAIRS) continue;
        float x0 = a[j] * inv;
        float x1 = b[j] * inv;
        if (kind == 2) {
            vc[cache + i] = float16_t(x0);
            vc[cache + i + PAIRS] = float16_t(x1);
            continue;
        }
        x0 *= kind == 0 ? qw[i] : kw[i];
        x1 *= kind == 0 ? qw[i + PAIRS] : kw[i + PAIRS];
        // Cody-Waite reduction to [-pi, pi], where Vulkan bounds sin/cos error.
        const float theta = position * inv_freq[i];
        const float turns = round(theta * 0.15915494309189535);
        const float r = (theta - turns * 6.28125) - turns * 0.0019353071795864769;
        const float c = cos(r);
        const float s = sin(r);
        const float r0 = x0 * c - x1 * s;
        const float r1 = x0 * s + x1 * c;
        if (kind == 0) {
            qo[(h * p.n + t) * HD + i] = r0;
            qo[(h * p.n + t) * HD + i + PAIRS] = r1;
        } else {
            kc[cache + i] = float16_t(r0);
            kc[cache + i + PAIRS] = float16_t(r1);
        }
    }
}
