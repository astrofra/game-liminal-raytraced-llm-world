#version 450
// out[r] = W[r] . x for Q6_K rows; port of ggml-metal's kernel_mul_mv_q6_K_f32
// (MIT). Same layout as gemv_q4k: 2 rows per 32-thread group, rows % 4 == 0.
#include "common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W8 { uint8_t w8[]; };
layout(std430, binding = 0) readonly buffer W8S { int8_t w8s[]; };
layout(std430, binding = 0) readonly buffer W16 { uint16_t w16[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform P { uint rows; uint row_bytes; uint x_off; uint o_off; float softcap; } p;
shared float red[2][64];

void main()
{
    const uint tid = gl_LocalInvocationID.x;
    const uint lane = tid % 32;
    const uint grp = tid / 32;
    const uint first_row = (flat_group() * 2 + grp) * 2;
    if (flat_group() * 4 >= p.rows) return;
    const uint nb = p.row_bytes / 210;
    const uint t2 = lane / 2;
    const uint ix = lane % 2;
    const uint ip = t2 / 8;
    const uint il = t2 % 8;
    const uint l0 = 4 * il;
    const uint is = 8 * ip + l0 / 16;
    const uint y_offset = 128 * ip + l0;
    const uint q_offset_l = 64 * ip + l0;
    const uint q_offset_h = 32 * ip + l0;
    float sumf[2] = {0.0, 0.0};
    for (uint i = ix; i < nb; i += 2) {
        float yl[16];
        const uint yb = p.x_off + i * 256 + y_offset;
        [[unroll]] for (uint l = 0; l < 4; ++l) {
            yl[4 * l + 0] = x[yb + l + 0];
            yl[4 * l + 1] = x[yb + l + 32];
            yl[4 * l + 2] = x[yb + l + 64];
            yl[4 * l + 3] = x[yb + l + 96];
        }
        [[unroll]] for (uint row = 0; row < 2; ++row) {
            const uint blk = (first_row + row) * p.row_bytes + i * 210;
            const uint q1 = blk + q_offset_l;
            const uint q2 = q1 + 32;
            const uint qh = blk + 128 + q_offset_h;
            const uint sc = blk + 192 + is;
            vec4 sums = vec4(0.0);
            [[unroll]] for (uint l = 0; l < 4; ++l) {
                const uint a = uint(w8[q1 + l]);
                const uint b = uint(w8[q2 + l]);
                const uint h = uint(w8[qh + l]);
                sums[0] += yl[4 * l + 0] * float(int((a & 0xFu) | ((h & 0x03u) << 4)) - 32);
                sums[1] += yl[4 * l + 1] * float(int((b & 0xFu) | ((h & 0x0Cu) << 2)) - 32);
                sums[2] += yl[4 * l + 2] * float(int((a >> 4) | (h & 0x30u)) - 32);
                sums[3] += yl[4 * l + 3] * float(int((b >> 4) | ((h & 0xC0u) >> 2)) - 32);
            }
            const float d = unpackHalf2x16(uint(w16[(blk + 208) / 2])).x;
            sumf[row] += d * (sums[0] * float(int(w8s[sc + 0])) + sums[1] * float(int(w8s[sc + 2])) +
                              sums[2] * float(int(w8s[sc + 4])) + sums[3] * float(int(w8s[sc + 6])));
        }
    }
    red[0][tid] = sumf[0];
    red[1][tid] = sumf[1];
    barrier();
    [[unroll]] for (uint s = 16; s > 0; s >>= 1) {
        if (lane < s) {
            red[0][tid] += red[0][tid + s];
            red[1][tid] += red[1][tid + s];
        }
        barrier();
    }
    if (lane < 2) {
        float v = red[lane][grp * 32];
        if (p.softcap > 0.0) v = p.softcap * tanh(v / p.softcap);
        o[p.o_off + first_row + lane] = v;
    }
}
