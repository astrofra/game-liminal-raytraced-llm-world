#version 450
// a[r][c] = gelu_tanh(a[r][c]) * b[b_off + r * b_stride + c], in place.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(push_constant) uniform P { uint rows; uint cols; uint b_off; uint b_stride; } p;

void main()
{
    const uint i = flat_group() * 256 + gl_LocalInvocationID.x;
    if (i >= p.rows * p.cols) return;
    const uint r = i / p.cols;
    const uint c = i % p.cols;
    a[i] = gelu_tanh(a[i]) * b[p.b_off + r * p.b_stride + c];
}
