#version 450
// Expands Q6_K rows to f16 [rows, cols]; one thread per 32-value subblock.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer W8 { uint8_t w8[]; };
layout(std430, binding = 0) readonly buffer W8S { int8_t w8s[]; };
layout(std430, binding = 0) readonly buffer W16 { uint16_t w16[]; };
layout(std430, binding = 1) writeonly buffer O { float16_t o[]; };
layout(push_constant) uniform P { uint rows; uint row_bytes; } p;

void main()
{
    const uint index = flat_group() * 256 + gl_LocalInvocationID.x;
    const uint cols = p.row_bytes / 210 * 256;
    const uint row = index / (cols / 32);
    if (row >= p.rows) return;
    const uint k_base = (index % (cols / 32)) * 32;
    const uint blk = row * p.row_bytes + (k_base / 256) * 210;
    const uint sub = (k_base % 256) / 32;
    const uint cluster = sub / 4;
    const uint cs = sub % 4;
    const uint low = blk + cluster * 64;
    const uint high = blk + 128 + cluster * 32;
    const float delta = unpackHalf2x16(uint(w16[(blk + 208) / 2])).x;
    const uint dst = row * cols + k_base;
    [[unroll]] for (uint i = 0; i < 32; ++i) {
        const uint ci = cs * 32 + i;
        const uint lo = (uint(w8[low + ci % 64]) >> ((ci / 64) * 4)) & 15u;
        const uint hi = ((uint(w8[high + i]) >> (cs * 2)) & 3u) << 4;
        o[dst + i] = float16_t(delta * float(int(w8s[blk + 192 + sub * 2 + i / 16]) * (int(lo | hi) - 32)));
    }
}
